{
  "manifest_version": 3,
  "name": "Waypoint OS - Ingestion Companion",
  "version": "1.1.0",
  "description": "Capture unstructured client travel inquiries from WhatsApp Web, Gmail, or web pages directly into Waypoint OS.",
  "permissions": [
    "activeTab",
    "scripting",
    "storage",
    "contextMenus",
    "alarms"
  ],
  "host_permissions": [
    "http://localhost:8000/*",
    "http://127.0.0.1:8000/*",
    "https://*/*"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "background": {
    "service_worker": "background.js"
  },
  "options_page": "settings.html"
}

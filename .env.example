# Waypoint OS environment template
# Copy to .env and fill values for your local environment.
# Never commit real secrets.

# =============================================================================
# Critical runtime settings
# =============================================================================

# REQUIRED: API signing secret
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"
JWT_SECRET=change-me-to-a-random-secret

# REQUIRED: signing secret for public proposal capability tokens
# (/api/public/proposals). The backend fails fast at startup without it.
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"
PROPOSAL_SIGNING_KEY=change-me-to-a-random-secret

# Optional: override where LEGACY (v2 "prop_...") proposal token revocations
# persist. Default: data/proposals/revoked_tokens.json — durable on ONE host
# (fcntl-locked merge-on-write, reloaded before every verification; hash-keyed
# since FND-0219 — raw token material is never written).
# Multi-replica deployments should issue v3 credentials (below), whose
# revocations live in PostgreSQL. For legacy v2 tokens on multiple replicas,
# point every replica at the same shared volume (with locking semantics).
# PROPOSAL_REVOCATIONS_PATH=data/proposals/revoked_tokens.json

# Optional (FND-0219): backend for the durable public proposal capability
# store (table proposal_access_tokens; alembic add_proposal_access_tokens).
#   memory (default): in-process — tests / single-worker only.
#   sql:              durable PostgreSQL rows via the app engine.
#   auto:             sql when DATABASE_URL is set, else memory.
# Production / multi-worker deployments MUST run sql (or auto with a database).
# SPINE_API_PROPOSAL_TOKEN_BACKEND=memory

# Optional (FND-0219): default TTL (hours) for newly issued v3 public proposal
# capability tokens. Documented default: 720 (30 days).
# PROPOSAL_TOKEN_TTL_HOURS=720

# Optional: allow outbound HTTP fetches to private/loopback targets
# (SSRF guard escape hatch for local provider stubs / docker-compose backends).
# Only enable in development.
# WAYPOINT_ALLOW_PRIVATE_URLS=0

# Optional: password for the local test agency user (newuser@test.com) used by
# benchmark/smoke tooling (tools/performance_benchmark_matrix.py). Required
# there when the default test-agency password is not set in your environment.
# WAYPOINT_TEST_PASSWORD=

# IMPORTANT: Trip persistence backend.
# Use sql for canonical local behavior with seeded agency data.
# Allowed values: file, json, sql
TRIPSTORE_BACKEND=sql

# Idempotency registry backend (PT-08).
# memory = in-process (single-worker/dev/test only); sql = durable
# idempotency_keys table (REQUIRED for multi-worker/multi-replica);
# auto = sql when DATABASE_URL is set, else memory.
# Allowed values: memory, sql, auto
SPINE_API_IDEMPOTENCY_BACKEND=memory

# Trip locking backend (FND-0225): mutual exclusion for trip critical
# sections. sql/postgres = Postgres pg_try_advisory_xact_lock (REQUIRED for
# multi-worker/multi-replica; a misconfigured backend REFUSES the critical
# section instead of silently downgrading). memory = in-process
# (single-worker/dev/test only, must be pinned explicitly). auto = derived
# from the session dialect (dev/test only; production boots REQUIRE an
# explicit sql/postgres pin).
# Allowed values: sql, postgres, postgresql, memory, auto
SPINE_API_LOCKING_BACKEND=auto

# Database URL for SQL-backed runtime (example uses local Postgres)
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/waypoint_os

# Public checker agency binding used by SQL preflight/startup checks.
# Must be a DEDICATED non-operating agency id (create via
# scripts/bootstrap_public_checker_agency.py). Do not point it at an agency
# with human members — anonymous submissions land in that workspace.
PUBLIC_CHECKER_AGENCY_ID=<dedicated-agency-uuid-from-bootstrap-script>

# Runtime kill switch for the public checker surface (RDA-2026-09-08 FT-05).
# Set to 0 to return 503 on all public-checker endpoints.
PUBLIC_CHECKER_ENABLED=1

# Size cap per public event-store segment (bytes) before rotation to `.1`
# (RDA-2026-09-08 FT-06). Default 10485760 (10 MiB) when unset.
PUBLIC_B_EVENTS_MAX_BYTES=10485760

# =============================================================================
# API server
# =============================================================================

SPINE_API_HOST=127.0.0.1
SPINE_API_PORT=8000
SPINE_API_WORKERS=1
SPINE_API_RELOAD=1
SPINE_API_CORS=http://localhost:3000,http://127.0.0.1:3000

# Dev-only auth bypass toggle. Leave unset/0 in normal development.
# SPINE_API_DISABLE_AUTH=1

# Expose password reset tokens in responses (dev-only; unsafe outside local)
# EXPOSE_RESET_TOKEN=1

# =============================================================================
# Safety + orchestration behavior
# =============================================================================

# 1 = block traveler output on leakage; 0 = log leakage only
TRAVELER_SAFE_STRICT=0

# Hybrid decision engine toggle (1=enabled, 0=rules only).
# Serving default is OFF (PA-03 / ADR-008). Opt in explicitly; do not pin 1
# in production images. CI may set 1 for hybrid-path evals.
USE_HYBRID_DECISION_ENGINE=0

# =============================================================================
# LLM provider configuration
# =============================================================================

# Primary provider: gemini | openai | local
LLM_PROVIDER=gemini

# Gemini
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-1.5-flash

# OpenAI fallback
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-4o-mini

# Local model options
LOCAL_LLM_MODEL=microsoft/phi-3-mini-4k-instruct
LOCAL_LLM_DEVICE=auto
LOCAL_LLM_MAX_TOKENS=512
HF_HUB_TOKEN=your_huggingface_token_here

# =============================================================================
# Cache tuning
# =============================================================================

DECISION_CACHE_TTL_DAYS=30
DECISION_CACHE_MIN_SUCCESS_RATE=0.7

# =============================================================================
# Document extraction
# =============================================================================

# noop (dev/test) | openai_vision (production-like)
EXTRACTION_PROVIDER=noop
OPENAI_VISION_MODEL=gpt-4o
OPENAI_VISION_TIMEOUT_SECONDS=30

# Optional OpenAI vision cost estimation knobs
# OPENAI_VISION_INPUT_COST_PER_1M=2.50
# OPENAI_VISION_OUTPUT_COST_PER_1M=10.00

# =============================================================================
# Optional observability
# =============================================================================

# Backend OTLP gRPC endpoint (example)
# SPINE_OTEL_EXPORTER_OTLP_GRPC_ENDPOINT=http://localhost:4317
# OTEL_SERVICE_NAME=spine_api

# =============================================================================
# Required-by-assertion runtime variables (FND-0263, 2026-09-11)
#
# These are read by live code paths and, in production-like environments,
# enforced by spine_api/core/startup_assertions.py. Leaving them out of this
# template previously produced silent runtime failures or dev-key fallbacks;
# every required var must appear here with an honest placeholder.
# =============================================================================

# Fernet key encrypting data at rest (booking confirmations incl. VCC ids).
# REQUIRED in production/staging (startup assertion FND-0262). Generate:
#   python3 -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
ENCRYPTION_KEY=

# Encryption posture for src/security (dogfood default in dev; production
# required in production/staging so the committed dev key is never used).
DATA_PRIVACY_MODE=dogfood

# HMAC secret signing human-AI capability tokens (src/services/boundary_engine.py).
# REQUIRED by the boundaries surface at runtime; generate a 32+ char random string.
CAPABILITY_TOKEN_SECRET=

# Shared Redis for rate limiting + usage accounting. REQUIRED in production/staging
# (startup assertion). redis:// or rediss://
# REDIS_URL=redis://localhost:6379/0

# WhatsApp / Twilio inbound channels (spine_api/routers/messaging.py). The
# multi-channel ingestion surface stays inert without these.
# WHATSAPP_VERIFY_TOKEN=
# WHATSAPP_APP_SECRET=
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# TWILIO_FROM_NUMBER=

# Stripe Issuing (VCC) + webhook signature verification.
# STRIPE_SECRET_KEY=
# STRIPE_WEBHOOK_SIGNING_KEY=

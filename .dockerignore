# Git
.git
.gitignore

# Build-time secrets and credentials. Docker's build context is independent of
# Git's ignore rules; keep every dotenv/certificate/key artifact out of every
# root-context image build (including local examples).
.env
.env.*
**/.env
**/.env.*
*.pem
*.key
*.p12
*.pfx
*.crt
*.csr

# Python
__pycache__
*.py[cod]
*.so
.mypy_cache
.pytest_cache
*.egg-info
.eggs

# Virtual envs
.venv
venv/
env/

# Frontend
frontend/node_modules
frontend/.next
frontend/.next-dev
frontend/out

# Docs and project files not needed in container
*.md
Docs/
Archive/
memory/
notebooks/
prompts/
specs/
tests/
tools/
*.log

# Runtime/user state. Production compose uses SQL and external/shared storage;
# these paths are created by the process when needed and must never be baked
# from a developer checkout into an image layer.
data/*
!data/
!data/cities.json
!data/cities5000.txt
!data/config/
!data/config/seasonal_campaigns.json
# seasonal_policy.json is runtime-loaded by ConfigStore
# (spine_api/persistence.py SEASONAL_POLICY_FILE) — omitting it would make
# containers silently serve the coerced default policy instead of the repo's
# seeded one.
!data/config/seasonal_policy.json

# Keep the broad rule above as a default-deny guard, and name the high-risk
# runtime directories explicitly so policy review catches future relocations.
data/runs/
data/documents/
data/audit/
data/trips/
data/test_trips/
data/drafts/
data/memory/
data/product_b_events/
data/proposals/
data/guard/
data/overrides/
data/assignments/
data/logs/
data/kdd/

# Evaluation, fixtures, and local team/demo state are not production inputs.
data/fixtures/
data/evals/
data/shadow/
data/team/
data/workflows.json
data/accumulated_cities.json
data/accumulated_cities.lock
data/test.db

# IDE
.vscode
.mcp
.qwen

# Local agent/tool state and settings (doc F-05 §4.5). These carry workspace
# permissions, local tool state, and per-agent config that must never reach a
# build context or image layer.
.claude/
.agents/
.agent/
.clawpatch/

# Root-level JS workspace. The frontend image builds from frontend/ (which has
# its own node_modules rule above); a root-context build must not ship this.
node_modules/

# Local runtime output: request/server logs and scratch artifacts. Logs can
# contain request bodies and credentials; nothing here is a build input.
logs/
output/

# Test and lint caches are regenerated per machine; shipping them only bloats
# the build context sent to the daemon.
.pytest_cache/
.ruff_cache/

# Dev session artifacts that contain live cookies.
dogfood_cookies.txt

# OS
.DS_Store
Thumbs.db
